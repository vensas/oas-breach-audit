{
  "name": "@vensas-gmbh/oas-breach-audit",
  "version": "1.0.0",
  "description": "Audit an OpenAPI-described HTTP service for BREACH compression-attack preconditions (compression + TLS + reflected input + secret-bearing responses).",
  "keywords": [
    "openapi",
    "security",
    "breach",
    "compression-attack",
    "http",
    "audit",
    "pentest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vensas/oas-breach-audit.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oas-breach-audit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "release": "semantic-release"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.2"
}
